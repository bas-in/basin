{
  "name": "api_keys_list",
  "description": "GET /v1/projects/{ref}/api-keys returns the keys envelope; table render prints the id, name, scope and the masked secret.",
  "steps": [
    {
      "request": {
        "method": "GET",
        "path": "/v1/projects/p_x/api-keys"
      },
      "response": {
        "status": 200,
        "body": {
          "keys": [
            {
              "id": "k_1",
              "name": "deploy-bot",
              "scope": "write",
              "prefix": "bso_acme_",
              "masked_key": "bso_acme_xxxx",
              "created_at": "2026-01-01T00:00:00Z"
            }
          ]
        }
      }
    }
  ],
  "command": ["api-keys", "list", "--project=p_x"],
  "expect_stdout_contains": ["k_1", "deploy-bot", "write", "bso_acme_xxxx"]
}
