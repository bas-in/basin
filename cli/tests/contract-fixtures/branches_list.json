{
  "name": "branches_list",
  "description": "GET /v1/projects/{ref}/branches returns the branches envelope; table render prints the branch name + ref.",
  "steps": [
    {
      "request": {
        "method": "GET",
        "path": "/v1/projects/p_x/branches"
      },
      "response": {
        "status": 200,
        "body": {
          "branches": [
            {
              "id": "b_1",
              "ref": "p_x_dev",
              "branch_name": "dev",
              "branch_kind": "branch",
              "status": "active",
              "created_at": "2026-01-01T00:00:00Z"
            }
          ]
        }
      }
    }
  ],
  "command": ["branches", "list", "--project=p_x"],
  "expect_stdout_contains": ["dev", "p_x_dev", "branch", "active"]
}
