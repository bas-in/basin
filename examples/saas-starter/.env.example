# Copy this file to .env.local and fill in the values.

# Basin server URL (pgwire port, also serves HTTP auth + REST)
VITE_BASIN_URL=http://localhost:5432

# Anonymous key — a JWT granting "anon" role.
# In the default dev Docker setup (no BASIN_AUTH_ENABLED) leave this empty.
# If basin-auth is enabled, generate an anon key via basin-cli or the admin API.
VITE_BASIN_ANON_KEY=

# Postgres connection URL for Drizzle migrations + seed script.
# Uses the same pgwire port.
DATABASE_URL=postgres://basin@localhost:5432/postgres

# Set to 1 to skip live Basin tests when no server is available.
BASIN_SKIP_LIVE_TESTS=0
