# Basin golden answers — recorded from the INCUMBENT engine (BASIN_OWNED_ENGINE unset).
# suite: base   area: Ordering/Pagination
# Do not hand-edit. Regenerate: BASIN_GOLDEN_RECORD=1 cargo test -p basin-integration-tests \
#   --test golden_answers -- --ignored --nocapture record_golden_answers
# Rows are sorted unless ORDER is `as-returned`. `\N` is NULL. Cells are tab-separated.

QUERY 0202
AREA Ordering/Pagination
SQL SELECT id, name FROM t ORDER BY id LIMIT 2
ORDER as-returned
STATUS rows
COL id	Int64	notnull
COL name	Utf8	null
NROWS 2
ROW 1	a
ROW 2	b
END

QUERY 0203
AREA Ordering/Pagination
SQL SELECT id FROM t LIMIT 2 OFFSET 1
ORDER sorted
CAVEAT row-limited without a top-level ORDER BY: which rows are returned is engine-defined, not SQL-defined
STATUS excluded
EXCLUDED row-limited without a top-level ORDER BY: SQL does not define WHICH rows come back, so any recorded set is an implementation detail
END

