{
    "name": "basin/basin-php",
    "description": "Official PHP client for the Basin HTTP API — REST data, auth, storage, functions, and realtime WebSocket.",
    "type": "library",
    "license": "MIT",
    "keywords": ["basin", "database", "rest", "realtime", "storage"],
    "homepage": "https://basin.run",
    "authors": [
        {
            "name": "Basin",
            "email": "support@basin.run"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0",
        "textalk/websocket": "^1.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "suggest": {
        "ratchet/pawl": "^0.4 — alternative async WebSocket client for ReactPHP environments"
    },
    "autoload": {
        "psr-4": {
            "Basin\\": "src/Basin/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Basin\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Basin\\Laravel\\BasinServiceProvider"
            ],
            "aliases": {
                "Basin": "Basin\\Laravel\\BasinFacade"
            }
        }
    }
}
